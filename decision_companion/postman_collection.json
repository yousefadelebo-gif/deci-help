    {
      "name": "Decisions",
      "item": [
        {
          "name": "List Decisions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/decisions",
              "host": ["{{baseUrl}}"],
              "path": ["decisions"],
              "query": [
                {
                  "key": "status",
                  "value": "DRAFT",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Create Decision",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('decisionId', jsonData.data.id);",
                  "    if (jsonData.data.options && jsonData.data.options.length > 0) {",
                  "        pm.collectionVariables.set('optionId', jsonData.data.options[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Which laptop to buy?\",\n    \"description\": \"I need to decide between MacBook Pro and Dell XPS\",\n    \"options\": [\n        {\n            \"name\": \"MacBook Pro M3\",\n            \"description\": \"Apple's latest laptop with M3 chip\"\n        },\n        {\n            \"name\": \"Dell XPS 15\",\n            \"description\": \"High-end Windows laptop\"\n        },\n        {\n            \"name\": \"ThinkPad X1 Carbon\",\n            \"description\": \"Business-focused laptop\"\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/decisions",
              "host": ["{{baseUrl}}"],
              "path": ["decisions"]
            }
          }
        },
        {
          "name": "Get Decision",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/decisions/{{decisionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["decisions", "{{decisionId}}"]
            }
          }
        },
        {
          "name": "Update Decision",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Which laptop to buy? (Updated)\",\n    \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/decisions/{{decisionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["decisions", "{{decisionId}}"]
            }
          }
        },
